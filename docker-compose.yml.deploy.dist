services:
  gateway:
    container_name: lenvora-gateway
    image: ghcr.io/beartrando/lenvora-gateway/service:${GATEWAY_VERSION}
    restart: unless-stopped
    env_file:
      - ./services/.env.gateway
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s

  auth:
    container_name: lenvora-auth
    image: ghcr.io/beartrando/lenvora-auth/service:${AUTH_VERSION}
    restart: unless-stopped
    env_file:
      - ./services/.env.auth
    environment:
      KAFKAJS_NO_PARTITIONER_WARNING: 1
    depends_on:
      pgbouncer:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  orchestration:
    container_name: lenvora-orchestration
    image: ghcr.io/beartrando/lenvora-orchestration/service:${ORCHESTRATION_VERSION}
    restart: unless-stopped
    env_file:
      - ./services/.env.orchestration
    depends_on:
      pgbouncer:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  remy:
    container_name: lenvora-remy
    image: ghcr.io/beartrando/lenvora-remy/service:${REMY_VERSION}
    restart: unless-stopped
    env_file:
      - ./services/.env.remy
    depends_on:
      pgbouncer:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  profile:
    container_name: lenvora-profile
    image: ghcr.io/beartrando/lenvora-profile/service:${PROFILE_VERSION}
    restart: unless-stopped
    env_file:
      - ./services/.env.profile
    depends_on:
      pgbouncer:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  gusteau:
    container_name: lenvora-gusteau
    image: ghcr.io/beartrando/lenvora-gusteau/service:${GUSTEAU_VERSION}
    restart: unless-stopped
    env_file:
      - ./services/.env.gusteau
    depends_on:
      pgbouncer:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  streaming:
    container_name: lenvora-streaming
    image: ghcr.io/beartrando/lenvora-streaming/service:${STREAMING_VERSION}
    restart: unless-stopped
    env_file:
      - ./services/.env.streaming
    depends_on:
      pgbouncer:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  speech-to-text:
    container_name: lenvora-speech-to-text
    image: ghcr.io/beartrando/lenvora-speech-to-text/service:${SPEECH_TO_TEXT_VERSION}
    restart: unless-stopped
    env_file:
      - ./services/.env.speech-to-text
    depends_on:
      pgbouncer:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  postgres:
    image: postgres:17.6
    container_name: lenvora-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: postgres
      POSTGRES_INITDB_ARGS: "--auth-host=md5"
    volumes:
      - ./services/infra/postgres/data:/var/lib/postgresql/data
#      - ./services/infra/postgres/docker-entrypoint-initdb.d:/docker-entrypoint-initdb.d
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 10s

  pgbouncer:
    image: edoburu/pgbouncer
    container_name: lenvora-pgbouncer
    restart: unless-stopped
    volumes:
      - ./services/infra/pgbouncer/userlist.txt:/etc/pgbouncer/userlist.txt
      - ./services/infra/pgbouncer/pgbouncer.ini:/etc/pgbouncer/pgbouncer.ini
    tmpfs:
      - /var/run/pgbouncer:uid=70,gid=70,mode=0755
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -h postgres -p 5432"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  redis:
    image: redis:7.2
    container_name: lenvora-redis
    restart: unless-stopped
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5


networks:
  backend:
    driver: bridge
  platform_infra:
    external: true
    name: platform_infra
