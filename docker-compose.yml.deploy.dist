#      test: ["CMD", "redis-cli", "ping"]
#      interval: 30s
#      timeout: 10s
#      retries: 5

volumes:
  kafka_data:
  elasticsearch_data:
  tempo_data:
  grafana_data:
  prometheus_data:
#  mongo_data:

networks:
  backend:
    driver: bridge
