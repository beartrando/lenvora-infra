services:
  gateway:
    build:
      context: .
      dockerfile: services/gateway/Dockerfile
      target: dev
      secrets:
        - gh_token
    container_name: lenvora-gateway
    env_file:
      - services/gateway/.env
    ports:
      - "9090:9090"
    volumes:
      - ./services/gateway/src:/usr/src/app/services/gateway/src/
      - ./services/gateway/package.json:/usr/src/app/services/gateway/package.json
    command: pnpm dlx turbo run dev --parallel --filter gateway
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  auth:
    build:
      context: .
      dockerfile: services/auth/Dockerfile
      target: dev
      secrets:
        - gh_token
    container_name: lenvora-auth
    env_file:
      - services/auth/.env
    environment:
      KAFKAJS_NO_PARTITIONER_WARNING: 1
    volumes:
      - ./services/auth/src:/usr/src/app/services/auth/src/
      - ./services/auth/package.json:/usr/src/app/services/auth/package.json
    depends_on:
      kafka:
        condition: service_healthy
      pgbouncer:
        condition: service_healthy
    command: pnpm dlx turbo run dev --parallel --filter auth
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  orchestration:
    build:
      context: .
      dockerfile: services/orchestration/Dockerfile
      target: dev
      secrets:
        - gh_token
    container_name: lenvora-orchestration
    env_file:
      - services/orchestration/.env
    volumes:
      - ./services/orchestration/src:/usr/src/app/services/orchestration/src/
      - ./services/orchestration/package.json:/usr/src/app/services/orchestration/package.json
    depends_on:
      kafka:
        condition: service_healthy
      pgbouncer:
        condition: service_healthy
    command: pnpm dlx turbo run dev --parallel --filter orchestration
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  remy:
    build:
      context: .
      dockerfile: services/remy/Dockerfile
      target: dev
      secrets:
        - gh_token
    container_name: lenvora-remy
    env_file:
      - services/remy/.env
    volumes:
      - ./services/remy/src:/usr/src/app/services/remy/src/
      - ./services/remy/package.json:/usr/src/app/services/remy/package.json
      - ./services/remy/jest.config.js:/usr/src/app/services/remy/jest.config.js
      - ./services/remy/jest.setup.ts:/usr/src/app/services/remy/jest.setup.ts
    depends_on:
      pgbouncer:
        condition: service_healthy
    command: pnpm dlx turbo run dev --parallel --filter remy
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  profile:
    build:
      context: .
      dockerfile: services/profile/Dockerfile
      target: dev
      secrets:
        - gh_token
    container_name: lenvora-profile
    env_file:
      - services/profile/.env
    volumes:
      - ./services/profile/src:/usr/src/app/services/profile/src/
      - ./services/profile/package.json:/usr/src/app/services/profile/package.json
    depends_on:
      kafka:
        condition: service_healthy
      pgbouncer:
        condition: service_healthy
    command: pnpm dlx turbo run dev --parallel --filter profile
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  gusteau:
    build:
      context: .
      dockerfile: services/gusteau/Dockerfile
      target: dev
      secrets:
        - gh_token
    container_name: lenvora-gusteau
    env_file:
      - services/gusteau/.env
    volumes:
      - ./services/gusteau/src:/usr/src/app/services/gusteau/src/
      - ./services/gusteau/package.json:/usr/src/app/services/gusteau/package.json
    depends_on:
      kafka:
        condition: service_healthy
      pgbouncer:
        condition: service_healthy
      redis:
        condition: service_healthy
    command: pnpm dlx turbo run dev --parallel --filter gusteau
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  streaming:
    build:
      context: .
      dockerfile: services/streaming/Dockerfile
      target: dev
      secrets:
        - gh_token
    container_name: lenvora-streaming
    env_file:
      - services/streaming/.env
    volumes:
      - ./services/streaming/src:/usr/src/app/services/streaming/src/
      - ./services/streaming/package.json:/usr/src/app/services/streaming/package.json
    depends_on:
      kafka:
        condition: service_healthy
      pgbouncer:
        condition: service_healthy
      redis:
        condition: service_healthy
    command: pnpm dlx turbo run dev --parallel --filter streaming
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  speech-to-text:
    build:
      context: .
      dockerfile: services/speech-to-text/Dockerfile
      target: dev
      secrets:
        - gh_token
    container_name: lenvora-speech-to-text
    env_file:
      - services/speech-to-text/.env
    volumes:
      - ./services/speech-to-text/src:/usr/src/app/services/speech-to-text/src/
      - ./services/speech-to-text/package.json:/usr/src/app/services/speech-to-text/package.json
    depends_on:
      kafka:
        condition: service_healthy
      pgbouncer:
        condition: service_healthy
      redis:
        condition: service_healthy
    command: pnpm dlx turbo run dev --parallel --filter speech-to-text
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  kafka-ui:
    image: provectuslabs/kafka-ui:latest
    container_name: lenvora-kafka-ui
    # ports:
    #   - "8081:8080"
    environment:
      KAFKA_CLUSTERS_0_NAME: local
      KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS: kafka:9092
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -qO- http://localhost:8080/actuator/health | grep '\"status\":\"UP\"' || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  kafka:
    image: apache/kafka:4.1.1
    container_name: lenvora-kafka
    ports:
      - "9092:9092"
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://:9092,CONTROLLER://:9093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:9092
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:9093
      KAFKA_CLUSTER_ID: e1aUPLXOTOqTnT0SvYXMIg
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
    volumes:
      - kafka_data:/var/utils/kafka/data
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "/opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --list >/dev/null 2>&1 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  postgres:
    image: postgres:17.6
    container_name: lenvora-postgres
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: postgres
      POSTGRES_INITDB_ARGS: "--auth-host=md5"
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    # - ./services/postgres/data:/var/lib/postgresql/data
    restart: always
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U postgres" ]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 10s

  pgbouncer:
    image: edoburu/pgbouncer
    container_name: lenvora-pgbouncer
    volumes:
      - ./services/pgbouncer/userlist.txt:/etc/pgbouncer/userlist.txt
      - ./services/pgbouncer/pgbouncer.ini:/etc/pgbouncer/pgbouncer.ini
    tmpfs:
      - /var/run/pgbouncer:uid=70,gid=70,mode=0755
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U postgres -h postgres -p 5432" ]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  redis:
    image: redis:7.2
    container_name: lenvora-redis
    restart: always
    networks:
      - backend
    healthcheck:
      test: [ "CMD", "redis-cli", "ping" ]
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  postgres_data:
  kafka_data:

networks:
  backend:
    driver: bridge

secrets:
  gh_token:
    environment: GH_TOKEN
