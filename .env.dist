# Сборка образов: @shared/* подключены как git-зависимости из приватных
# репозиториев beartrando/{logger,errors,kafka-manager,grpc-client-manager,pg-boss-manager}.
# Дocker-сборке нужен токен GitHub (секрет gh_token):
#   GH_TOKEN=$(gh auth token) docker compose build
# или впишите токен сюда (этот файл в git не попадает):
GH_TOKEN=
